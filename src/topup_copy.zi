// The page's words in English, German and Spanish. %1, %2 and %3 stand for
// the values Fill puts in, so each language keeps its own word order.
TopupCopy :: struct {
    language: string
    tagline: string
    sign_in: string
    profile: string
    back: string
    sign_in_title: string
    sign_in_hint: string
    balance: string
    signed_in_as: string
    node_error: string
    node_retry: string
    retry_now: string
    guest_for: string
    guest_hint: string
    account_invalid: string
    how_much: string
    other_amount: string
    other_amount_hint: string
    choose_amount: string
    loading_rate: string
    amount: string
    about: string
    pay_monero: string
    any_amount: string
    sign_in_address: string
    address_retry: string
    address_loading: string
    copy_address: string
    copied: string
    confirmations: string
    activity: string
    deposit_confirming: string
    deposit_confirmed: string
    deposit_credited: string
    deposit_below: string
    deposit_double: string
    other_coin: string
    other_coin_body: string
    pay_other: string
    sign_in_first: string
    minimum: string
    opens: string
    fee: string
    footer: string
}

TopupEnglish :: () -> TopupCopy {
    return TopupCopy.{
        .language = "en",
        .tagline = "One currency for every Waozi app. Top it up here with Monero or almost any other coin.",
        .sign_in = "Sign in",
        .profile = "Profile",
        .back = "Back",
        .sign_in_title = "Sign in with your profile to see your Dew and top it up.",
        .sign_in_hint = "Use the same profile as in Inner Breeze, Arcade or Shovey: link this browser from the app, or import your key.",
        .balance = "Your balance",
        .signed_in_as = "Signed in as %1",
        .node_error = "The node did not answer. The balance shown is the last one it confirmed.",
        .node_retry = "The Dew node is not answering right now. Trying again in %1 s.",
        .retry_now = "Retry now",
        .guest_for = "You are topping up Dew for %1.",
        .guest_hint = "Sign in to see the balance. You don't need to for paying.",
        .account_invalid = "That account link is not valid. Sign in to top up your own Dew.",
        .how_much = "How much Dew?",
        .other_amount = "Other amount",
        .other_amount_hint = "Other amount in Dew",
        .choose_amount = "Choose an amount, or type any whole number of Dew.",
        .loading_rate = "Loading the rate…",
        .amount = "%1 Dew = %2",
        .about = "about %1",
        .pay_monero = "Pay with Monero",
        .any_amount = "Any amount works. You get Dew for exactly the Monero that arrives.",
        .sign_in_address = "Sign in to see your own Monero address.",
        .address_retry = "The address could not be loaded yet. Trying again…",
        .address_loading = "Getting the address…",
        .copy_address = "Copy address",
        .copied = "Copied",
        .confirmations = "Dew arrives after %1 confirmations, about %2 minutes after you send.",
        .activity = "Activity",
        .deposit_confirming = "%1 · %2 of %3 confirmations",
        .deposit_confirmed = "%1 · confirmed, adding Dew…",
        .deposit_credited = "%1 · %2 Dew added",
        .deposit_below = "%1 · below the minimum",
        .deposit_double = "%1 · rejected (double spend)",
        .other_coin = "Pay with another coin",
        .other_coin_body = "Bitcoin, Ethereum, Litecoin, USDT and hundreds more. Trocador swaps the coin to Monero and sends it to the Dew address.",
        .pay_other = "Buy %1 Dew with another coin",
        .sign_in_first = "Sign in first, so Trocador sends to your own address.",
        .minimum = "Other coins need at least %1 Dew (%2). Monero takes any amount.",
        .opens = "Opens trocador.app in a new tab.",
        .fee = "Opens trocador.app in a new tab. Trocador adds its swap fee to what you pay, so %1 Dew arrive; whatever Monero arrives becomes Dew.",
        .footer = "Dew works in every Waozi app: unlock practices and storage in Inner Breeze, dress up your worm in Apfelwurm and earn it in Shovey."}
}

