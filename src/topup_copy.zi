// The copy for a browser language such as "de-AT"; English otherwise.
TopupCopyFor :: (language: string) -> TopupCopy {
    if language.count >= 2 {
        first := language[0] | cast(u8)32
        second := language[1] | cast(u8)32
        if first == cast(u8)100 && second == cast(u8)101 { return TopupGerman() }
        if first == cast(u8)101 && second == cast(u8)115 { return TopupSpanish() }
    }
    return TopupEnglish()
}
