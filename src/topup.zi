// dew.waozi.xyz: one focused page for buying Dew, the currency every Waozi
// app shares. The account comes from Entity's shared Profile, whose provider
// keeps the keys; this page only reads the balance, deposits and the
// account's own Monero address from the node and draws them. A link may name
// another account (?account=ID), whose public address the page then shows.
#import "topup_model"
#import "topup_copy"
#import "entity/native_host"
#import "entity/dew_model"
#import "qrcode/qrcode"
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/text_props"
#import "kryon/text_align"
#import "kryon/text_widget"
#import "kryon/text_measure"
#import "kryon/text_input_props"
#import "kryon/text_field_widget"
#import "kryon/button_props"
#import "kryon/button_widget"
#import "kryon/control_props"
#import "kryon/scroll_props"
#import "kryon/scroll_widget"
#import "kryon/tree"
#import "kryon/box_props"
#import "kryon/box_widget"
#import "kryon/drawing_props"
#import "kryon/svg_icon_props"
#import "kryon/svg_icon_widget"
#import "kryon/widget_palette"
#import "kryon/system_clipboard"
#import "kryon/open_uri"
#import "kryon/http_transfer"
#import "std/net_http"
#import "std/c_string"
#import "std/text_buffer"
#import "std/number_text"

TOPUP_NONE :: 0
TOPUP_SIGN_IN :: 1
TOPUP_PROFILE :: 2

DEW_BACKGROUND :: 0x0e1a20ff
DEW_CARD :: 0x172a33ff
DEW_ACCENT :: 0x2f9fc4ff

// The water drop Entity draws for Dew.
DROP_SHAPE :: "S1.7rr:M12 3C10 6 5 11 5 15C5 24 19 24 19 15C19 11 14 6 12 3ZM8 15C8 18 10 19 12 19"

DewPalette :: () -> WidgetPalette {
    return WidgetPalette.{.background = cast(u32)DEW_BACKGROUND, .base = cast(u32)0x223a45ff,
        .text = cast(u32)0xe8f3f7ff, .selected = cast(u32)DEW_ACCENT,
        .selected_text = cast(u32)0xffffffff, .border = cast(u32)0x3a5562ff,
        .danger = cast(u32)0xff8a7aff, .warning = cast(u32)0xffca0cff,
        .success = cast(u32)0x4cc38aff, .material = true}
}

AmountField :: struct { cursor: s32; anchor: s32; scroll_x: s32; focused: bool }

topup_copy: TopupCopy;
DEW_PRESETS: [4]s64 = .[100, 500, 1000, 5000];
// The chosen preset, or -1 while the typed amount counts.
topup_preset: s32 = 1;
topup_typed: [16]u8;
topup_field: AmountField;
topup_scroll: s32;
topup_content_height: float32 = 1600.0;
topup_card_heights: [5]float32 = .[180.0, 160.0, 200.0, 420.0, 260.0];
topup_copied_until: float64;
topup_refreshed_at: float64 = -100000.0;
topup_address_at: float64 = -100000.0;
topup_deposits_at: float64 = -100000.0;
// After a request the node did not answer, the next waits longer each time
// (10 s doubling to 5 min), so a struggling node is not flooded.
topup_attempt_pending: bool;
topup_failures: s32;
topup_retry_at: float64;

// The node's public rate and dollar price, fetched every ten minutes.
topup_rates: DewRates;
topup_rates_known: bool;
topup_rates_running: bool;
topup_rates_at: float64 = -1000000.0;
topup_rates_transfer: HttpTransfer;
topup_rates_answer: [4096]u8;

// The account a link names: 0 none, 1 loading, 2 known, 3 not found.
TOPUP_GUEST_NONE :: 0
TOPUP_GUEST_LOADING :: 1
TOPUP_GUEST_KNOWN :: 2
TOPUP_GUEST_INVALID :: 3
topup_reference: [80]u8;
topup_guest_state: s32;
topup_guest_running: bool;
topup_guest_at: float64 = -1000000.0;
topup_guest_transfer: HttpTransfer;
topup_guest_answer: [8192]u8;
topup_guest_funding: DewFunding;
topup_guest_account: [65]u8;
topup_guest_alias: [40]u8;

// The newest deposits of the signed-in account, read from Entity's last list.
topup_deposits: [3]DewDeposit;
topup_deposit_count: s32 = -1;
topup_deposits_parsed_at: float64 = -100000.0;
topup_credited: s64 = -1;

// The QR code of the current wallet link, built only when the link changes.
QrRect :: struct { column: s32; row: s32; width: s32; height: s32 }
QR_RECTS :: 2048
topup_qr: QrCode;
topup_qr_text: [512]u8;
topup_qr_valid: bool;
topup_qr_rects: [QR_RECTS]QrRect;
topup_qr_count: s32;

topup_link: [1024]u8;
topup_wallet: [512]u8;

// The page's language ("de", "es" or anything else for English) and its
// query, such as "?account=ID&lang=de".
TopupStart :: (query: string, language: string) {
    chosen: [8]u8
    asked := QueryValue(query, "lang", chosen[:])
    topup_copy = TopupCopyFor(ifx asked != "" then asked else language)
    if QueryValue(query, "account", topup_reference[:]) != "" { topup_guest_state = TOPUP_GUEST_LOADING }
}

// Keeps the balance, address, deposits and rate fresh. Requests share
// Entity's one Dew queue, so each waits for the previous to finish.
TopupPump :: (now: float64) {
    TopupRatesPump(now)
    TopupGuestPump(now)
    status := EntityHostDewStatus()
    if !status.ready {
        topup_deposit_count = -1
        topup_credited = -1
        return
    }
    if now - topup_deposits_parsed_at > 2000.0 {
        topup_deposits_parsed_at = now
        TopupReadDeposits()
    }
    if status.busy { return }
    if topup_attempt_pending {
        topup_attempt_pending = false
        if status.error {
            if topup_failures < 5 { topup_failures += 1 }
            topup_retry_at = now + 10000.0 * cast(float64)(1 << cast(u32)(topup_failures - 1))
            if topup_retry_at > now + 300000.0 { topup_retry_at = now + 300000.0 }
        } else {
            topup_failures = 0
            topup_retry_at = 0.0
        }
    }
    if now < topup_retry_at { return }
    if !status.known || status.error && now - topup_refreshed_at > 10000.0 {
        if EntityHostDewRequest("refresh") { topup_refreshed_at = now; topup_attempt_pending = true }
        return
    }
    if !status.funded && status.funding_allowed {
        if EntityHostDewRequest("address") { topup_address_at = now; topup_attempt_pending = true }
        return
    }
    if status.funded && now - topup_deposits_at > 20000.0 {
        if EntityHostDewRequest("deposits") { topup_deposits_at = now; topup_attempt_pending = true }
        return
    }
    if now - topup_refreshed_at > 30000.0 {
        if EntityHostDewRequest("refresh") { topup_refreshed_at = now; topup_attempt_pending = true }
    }
}

// Asks again at once, from the Retry button.
TopupRetry :: () {
    topup_retry_at = 0.0
    topup_refreshed_at = -100000.0
}

// A deposit the node newly credits refreshes the balance at once.
TopupReadDeposits :: () {
    count := DewParseDeposits(EntityHostDewDeposits(), topup_deposits[:])
    if count < 0 { return }
    topup_deposit_count = count
    credited: s64 = 0
    for index: 0..count - 1 {
        if TextUntilNul(topup_deposits[index].status[:]) == "credited" { credited += 1 }
    }
    if topup_credited >= 0 && credited > topup_credited { topup_refreshed_at = -100000.0 }
    topup_credited = credited
}

TopupRatesPump :: (now: float64) {
    if topup_rates_running {
        status: s32
        done := HttpTransferPoll(*topup_rates_transfer, *status)
        if done < 0 { return }
        topup_rates_running = false
        rates: DewRates
        if done == 1 && status == 200 && DewParseRates(TextUntilNul(topup_rates_answer[:]), *rates) {
            topup_rates = rates
            topup_rates_known = true
        }
        HttpTransferCancel(*topup_rates_transfer)
        return
    }
    if now - topup_rates_at < 600000.0 { return }
    topup_rates_at = now
    request := HttpRequest.{.method = "GET", .url = "https://api.waozi.xyz/api/v1/rates", .accept = "application/json"}
    topup_rates_answer = .{}
    topup_rates_running = HttpTransferStart(*topup_rates_transfer, request, topup_rates_answer[:], 20000)
}

// The public address of the account a link names; no sign-in needed.
TopupGuestPump :: (now: float64) {
    if topup_guest_running {
        status: s32
        done := HttpTransferPoll(*topup_guest_transfer, *status)
        if done < 0 { return }
        topup_guest_running = false
        if done == 1 && status == 200 && DewParseRecipient(TextUntilNul(topup_guest_answer[:]),
            *topup_guest_funding, topup_guest_account[:], topup_guest_alias[:]) {
            topup_guest_state = TOPUP_GUEST_KNOWN
        } else if done == 1 && (status == 400 || status == 404) {
            topup_guest_state = TOPUP_GUEST_INVALID
        }
        HttpTransferCancel(*topup_guest_transfer)
        return
    }
    if topup_guest_state != TOPUP_GUEST_LOADING || now - topup_guest_at < 15000.0 { return }
    topup_guest_at = now
    url: [256]u8
    at: s64 = 0
    if !Append(url[:], *at, "https://api.waozi.xyz/api/v1/tokens/purchases/monero/address/") ||
    !Append(url[:], *at, TextUntilNul(topup_reference[:])) {
        topup_guest_state = TOPUP_GUEST_INVALID
        return
    }
    request := HttpRequest.{.method = "GET", .url = TextUntilNul(url[:]), .accept = "application/json"}
    topup_guest_answer = .{}
    topup_guest_running = HttpTransferStart(*topup_guest_transfer, request, topup_guest_answer[:], 20000)
}

// Draws the page; returns TOPUP_SIGN_IN or TOPUP_PROFILE when the Profile
// should open.
TopupFrame :: (session: Session, viewport: Rectangle, input: TextFieldInput, now: float64) -> s32 {
    copy := topup_copy
    action: s32 = TOPUP_NONE
    status := EntityHostDewStatus()
    // A link to the signed-in account's own address is the ordinary page.
    guest := topup_guest_state == TOPUP_GUEST_KNOWN &&
    !(status.funded && TextUntilNul(status.funding.address[:]) == TextUntilNul(topup_guest_funding.address[:]))
    funded := guest || status.funded
    funding := ifx guest then topup_guest_funding else status.funding
    rate := ifx funded then DewRate.{funding.atomic, funding.units} else topup_rates.rate
    usd := ifx topup_rates_known then topup_rates.usd_cents else cast(s64)0
    dew := ifx topup_preset >= 0 then DEW_PRESETS[topup_preset] else DewTyped(TextUntilNul(topup_typed[:]))
    atomic := DewAtomic(dew, rate)
    minimum := DewAtLeast(TROCADOR_MINIMUM_ATOMIC, rate)
    filled: [512]u8

    Box(session, BoxProps.{.key = cast(u64)60000, .bounds = viewport, .fill = ColorFromPacked(cast(u32)DEW_BACKGROUND)})
    scroll := Scroll(session, ScrollProps.{.key = cast(u64)60001, .bounds = viewport,
            .content_height = cast(s32)topup_content_height, .scroll_offset = topup_scroll})
    topup_scroll = scroll.scroll_offset
    if !scroll.opened { return action }
    defer { unused End(session) }
    column := scroll.content.width - 32.0
    if column > 560.0 { column = 560.0 }
    x := scroll.content.x + (scroll.content.width - column) * 0.5
    y := scroll.content.y + 28.0
    top := y

    // Title row: the drop, "Dew", and the Profile.
    Box(session, BoxProps.{.key = cast(u64)60002, .bounds = Rectangle.{x, y, 48.0, 48.0},
            .fill = ColorFromPacked(cast(u32)DEW_ACCENT), .radius = 24.0})
    SvgIcon(session, SvgIconProps.{.shape = DROP_SHAPE, .color = Color.{255, 255, 255, 255},
            .bounds = Rectangle.{x + 12.0, y + 11.0, 24.0, 26.0}})
    Text(session, TextProps.{.key = cast(u64)60003, .text = "Dew", .font = 32,
            .bounds = Rectangle.{x + 62.0, y + 4.0, column - 220.0, 40.0}})
    if Button(session, ButtonProps.{.key = cast(u64)60004, .id = 60004,
            .label = ifx status.ready then copy.profile else copy.sign_in,
            .bounds = Rectangle.{x + column - 140.0, y + 4.0, 140.0, 40.0},
            .tone = ButtonTone.ButtonToneAccent, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
        action = ifx status.ready then TOPUP_PROFILE else TOPUP_SIGN_IN
    }
    y += 62.0
    Line(session, 60005, copy.tagline, x, *y, column, 17, 26.0)

    // Whose Dew, and the balance.
    inner := column - 36.0
    card_y := y
    Card(session, 60010, x, y, column, topup_card_heights[0])
    y += 18.0
    if guest {
        name := TextUntilNul(topup_guest_alias[:])
        short: [16]u8
        if name == "" {
            unused CopyCString(TextUntilNul(topup_guest_account[:])[:8], short[:])
            name = TextUntilNul(short[:])
        }
        Line(session, 60019, Fill(copy.guest_for, name, "", "", filled[:]), x + 18.0, *y, inner, 18, 10.0)
    }
    if topup_guest_state == TOPUP_GUEST_INVALID {
        Line(session, 60009, copy.account_invalid, x + 18.0, *y, inner, 15, 10.0)
    }
    if !status.ready {
        if guest {
            Line(session, 60012, copy.guest_hint, x + 18.0, *y, inner, 14, 14.0)
        } else {
            Line(session, 60011, copy.sign_in_title, x + 18.0, *y, inner, 18, 10.0)
            Line(session, 60012, copy.sign_in_hint, x + 18.0, *y, inner, 14, 14.0)
        }
        if Button(session, ButtonProps.{.key = cast(u64)60013, .id = 60013, .label = copy.sign_in,
                .bounds = Rectangle.{x + 18.0, y, inner, 48.0}, .tone = ButtonTone.ButtonToneAccent}) != 0 {
            action = TOPUP_SIGN_IN
        }
        y += 48.0
    } else {
        Line(session, 60014, copy.balance, x + 18.0, *y, inner, 14, 4.0)
        amount: [64]u8
        balance := "…"
        if status.known && DewFormat(status.account.balance, DewUnits, amount[:], "Dew") { balance = TextUntilNul(amount[:]) }
        Line(session, 60015, balance, x + 18.0, *y, inner, 34, 6.0)
        if status.known {
            worth: [160]u8
            Line(session, 60016, WorthText(status.account.balance, rate, usd, worth[:]), x + 18.0, *y, inner, 15, 8.0)
        }
        who := TextUntilNul(status.alias[:])
        if who == "" { who = TextUntilNul(status.name[:]) }
        if who != "" { Line(session, 60017, Fill(copy.signed_in_as, who, "", "", filled[:]), x + 18.0, *y, inner, 14, 4.0) }
        if status.error {
            wait := cast(s64)((topup_retry_at - now) / 1000.0) + 1
            seconds: [24]u8
            Line(session, 60018, ifx topup_retry_at > now then Fill(copy.node_retry, FormatInteger(wait, seconds[:]), "", "", filled[:]) else copy.node_error,
                x + 18.0, *y, inner, 14, 8.0)
            if topup_retry_at > now && Button(session, ButtonProps.{.key = cast(u64)60008, .id = 60008, .label = copy.retry_now,
                    .bounds = Rectangle.{x + 18.0, y, 180.0, 40.0}, .tone = ButtonTone.ButtonToneAccent,
                    .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
                TopupRetry()
            }
            if topup_retry_at > now { y += 48.0 }
        }
    }
    y += 18.0
    topup_card_heights[0] = y - card_y
    y += 16.0

    // Payments on their way to the signed-in account.
    if status.ready && status.funded && !guest && topup_deposit_count >= 0 {
        card_y = y
        Card(session, 60060, x, y, column, topup_card_heights[1])
        y += 18.0
        Line(session, 60061, copy.incoming, x + 18.0, *y, inner, 21, 10.0)
        if topup_deposit_count == 0 { Line(session, 60062, copy.no_deposits, x + 18.0, *y, inner, 15, 0.0) }
        for index: 0..topup_deposit_count - 1 {
            line: [256]u8
            Line(session, cast(u64)(60063 + index), DepositText(topup_deposits[index], funding.confirmations, line[:]),
                x + 18.0, *y, inner, 15, 6.0)
        }
        y += 18.0
        topup_card_heights[1] = y - card_y
        y += 16.0
    }

    // How much Dew.
    card_y = y
    Card(session, 60020, x, y, column, topup_card_heights[2])
    y += 18.0
    Line(session, 60021, copy.how_much, x + 18.0, *y, inner, 21, 12.0)
    gap: float32 = 8.0
    chip := (inner - gap * 3.0) / 4.0
    for index: 0..3 {
        label: [24]u8
        if Button(session, ButtonProps.{.key = cast(u64)(60022 + index), .id = 60022 + cast(s32)index,
                .label = FormatInteger(DEW_PRESETS[index], label[:]),
                .bounds = Rectangle.{x + 18.0 + cast(float32)index * (chip + gap), y, chip, 46.0},
                .selected = topup_preset == cast(s32)index, .tone = ButtonTone.ButtonToneAccent,
                .emphasis = ifx topup_preset == cast(s32)index then ButtonEmphasis.ButtonEmphasisFilled else ButtonEmphasis.ButtonEmphasisOutline}) != 0 {
            topup_preset = cast(s32)index
            topup_typed = .{}
            topup_field = .{}
        }
    }
    y += 56.0
    if AmountInput(session, Rectangle.{x + 18.0, y, inner, 46.0}, input, copy) && topup_typed[0] != cast(u8)0 { topup_preset = -1 }
    if topup_field.focused && topup_typed[0] != cast(u8)0 { topup_preset = -1 }
    y += 56.0
    Line(session, 60027, AmountText(dew, atomic, usd, filled[:]), x + 18.0, *y, inner, 16, 0.0)
    y += 18.0
    topup_card_heights[2] = y - card_y
    y += 16.0

    // Monero, any amount.
    card_y = y
    Card(session, 60030, x, y, column, topup_card_heights[3])
    y += 18.0
    Line(session, 60031, copy.pay_monero, x + 18.0, *y, inner, 21, 8.0)
    Line(session, 60032, copy.any_amount, x + 18.0, *y, inner, 15, 14.0)
    if funded {
        address := TextUntilNul(funding.address[:])
        wallet := MoneroUri(address, ifx atomic > 0 then atomic else cast(s64)0, topup_wallet[:])
        side := DrawQr(session, wallet, x + 18.0, y, inner)
        if side > 0.0 { y += side + 14.0 }
        Line(session, 60035, address, x + 18.0, *y, inner, 15, 12.0)
        copied := now < topup_copied_until
        if Button(session, ButtonProps.{.key = cast(u64)60036, .id = 60036, .label = ifx copied then copy.copied else copy.copy_address,
                .bounds = Rectangle.{x + 18.0, y, inner, 46.0}, .tone = ButtonTone.ButtonToneAccent,
                .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
            if SystemClipboardSet(address) { topup_copied_until = now + 2000.0 }
        }
        y += 58.0
        minutes: [24]u8
        count: [24]u8
        Line(session, 60037, Fill(copy.confirmations, FormatInteger(funding.confirmations, count[:]),
            FormatInteger(funding.confirmations * 2, minutes[:]), "", filled[:]), x + 18.0, *y, inner, 14, 0.0)
    } else if !status.ready && topup_guest_state != TOPUP_GUEST_LOADING {
        Line(session, 60033, copy.sign_in_address, x + 18.0, *y, inner, 15, 0.0)
    } else {
        Line(session, 60034, ifx status.error then copy.address_retry else copy.address_loading, x + 18.0, *y, inner, 15, 0.0)
    }
    y += 18.0
    topup_card_heights[3] = y - card_y
    y += 16.0

    // Any other coin, through Trocador.
    card_y = y
    Card(session, 60040, x, y, column, topup_card_heights[4])
    y += 18.0
    Line(session, 60041, copy.other_coin, x + 18.0, *y, inner, 21, 8.0)
    Line(session, 60042, copy.other_coin_body, x + 18.0, *y, inner, 15, 14.0)
    link := ""
    if funded && atomic > 0 { link = TrocadorUrl(TextUntilNul(funding.address[:]), atomic, dew, copy.language, topup_link[:]) }
    digits: [24]u8
    pay: [128]u8
    pay_label := ifx dew > 0 then Fill(copy.pay_other, FormatInteger(dew, digits[:]), "", "", pay[:]) else copy.other_coin
    if Button(session, ButtonProps.{.key = cast(u64)60043, .id = 60043, .label = pay_label,
            .bounds = Rectangle.{x + 18.0, y, inner, 48.0}, .tone = ButtonTone.ButtonToneAccent,
            .disabled = link == ""}) != 0 && link != "" {
        unused OpenUri(link)
    }
    y += 60.0
    if !funded && !status.ready && topup_guest_state != TOPUP_GUEST_LOADING {
        Line(session, 60044, copy.sign_in_first, x + 18.0, *y, inner, 14, 6.0)
    } else if minimum > 0 && dew < minimum {
        least: [24]u8
        xmr: [48]u8
        Line(session, 60045, Fill(copy.minimum, FormatInteger(minimum, least[:]), XmrText(TROCADOR_MINIMUM_ATOMIC, xmr[:]), "", filled[:]),
            x + 18.0, *y, inner, 14, 6.0)
    }
    fee := ifx dew > 0 then Fill(copy.fee, FormatInteger(dew, digits[:]), "", "", filled[:]) else copy.opens
    Line(session, 60046, fee, x + 18.0, *y, inner, 14, 0.0)
    y += 18.0
    topup_card_heights[4] = y - card_y
    y += 24.0

    Line(session, 60050, copy.footer, x, *y, column, 15, 10.0)
    if Button(session, ButtonProps.{.key = cast(u64)60051, .id = 60051, .label = "waozi.xyz",
            .bounds = Rectangle.{x, y, 140.0, 40.0}, .tone = ButtonTone.ButtonToneAccent,
            .emphasis = ButtonEmphasis.ButtonEmphasisGhost}) != 0 {
        unused OpenUri("https://waozi.xyz/")
    }
    y += 64.0
    topup_content_height = y - top + 28.0
    return action
}

Card :: (session: Session, key: u64, x: float32, y: float32, width: float32, height: float32) {
    Box(session, BoxProps.{.key = key, .bounds = Rectangle.{x, y, width, height},
            .fill = ColorFromPacked(cast(u32)DEW_CARD), .radius = 16.0})
}

// Wrapped text that moves y below itself and the gap after it.
Line :: (session: Session, key: u64, text: string, x: float32, y: *float32, width: float32, font: s32, gap: float32) {
    if text == "" { return }
    props := TextProps.{.key = key, .text = text, .font = font, .wrap = TextWrap.TextWrapAuto,
        .bounds = Rectangle.{x, y.*, width, 0.0}}
    height := cast(float32)TextHeight(session, props)
    props.bounds.height = height
    Text(session, props)
    y.* += height + gap
}

AmountInput :: (session: Session, bounds: Rectangle, input: TextFieldInput, copy: TopupCopy) -> bool {
    snapshot: [16]u8
    snapshot = topup_typed
    props := TextFieldProps.{.key = cast(u64)60026, .focus_id = 60026, .bounds = bounds,
        .label = copy.other_amount, .placeholder = copy.other_amount_hint,
        .value = TextUntilNul(snapshot[:]), .cursor = topup_field.cursor, .anchor = topup_field.anchor,
        .scroll_x = topup_field.scroll_x, .focused = topup_field.focused,
        .max_bytes = 7, .max_codepoints = 7, .numeric = true}
    if topup_field.focused { props.input = input }
    result := TextField(session, props)
    changed := false
    if result.edit.changed {
        edit := result.edit
        length := cast(s32)TextUntilNul(topup_typed[:]).count
        new_length := length - (edit.end - edit.start) + cast(s32)edit.replacement.count
        if edit.start >= 0 && edit.end >= edit.start && edit.end <= length && new_length <= 7 {
            next: [16]u8
            at: s32 = 0
            for index: 0..edit.start - 1 { next[at] = topup_typed[index]; at += 1 }
            for byte: edit.replacement { next[at] = byte; at += 1 }
            for index: edit.end..length - 1 { next[at] = topup_typed[index]; at += 1 }
            topup_typed = next
            changed = true
        }
    }
    if result.clipboard_write { unused SystemClipboardSet(result.clipboard_text) }
    topup_field = AmountField.{result.cursor, result.anchor, result.scroll_x, result.focused && !result.escaped}
    return changed
}

// The QR code of a wallet link, in a white square at most 240 wide.
DrawQr :: (session: Session, text: string, x: float32, y: float32, width: float32) -> float32 {
    if text == "" { return 0.0 }
    if text != TextUntilNul(topup_qr_text[:]) {
        topup_qr_valid = CopyCString(text, topup_qr_text[:]) && QrEncodeText(text, QrEcc.QrEccMedium, *topup_qr)
        if topup_qr_valid { QrBuild() }
    }
    if !topup_qr_valid { return 0.0 }
    modules := topup_qr.size + 8
    limit := cast(s32)width
    if limit > 240 { limit = 240 }
    cell := limit / modules
    if cell < 1 { return 0.0 }
    side := cell * modules
    left := cast(s32)(x + (width - cast(float32)side) * 0.5)
    top := cast(s32)y
    Box(session, BoxProps.{.key = cast(u64)61000, .radius = 10.0,
            .bounds = Rectangle.{cast(float32)left, y, cast(float32)side, cast(float32)side}, .fill = Color.{255, 255, 255, 255}})
    for index: 0..topup_qr_count - 1 {
        rect := topup_qr_rects[index]
        Box(session, BoxProps.{.key = cast(u64)(61001 + index),
                .bounds = Rectangle.{cast(float32)(left + (rect.column + 4) * cell), cast(float32)(top + (rect.row + 4) * cell),
                    cast(float32)(rect.width * cell), cast(float32)(rect.height * cell)}, .fill = Color.{0, 0, 0, 255}})
    }
    return cast(float32)side
}

// Merges each run of dark modules with the same run in the row above, so a
// code takes a few hundred rectangles instead of thousands of squares.
QrBuild :: () {
    topup_qr_count = 0
    open: [QR_SIZE_MAX]s32
    next: [QR_SIZE_MAX]s32
    for column: 0..QR_SIZE_MAX - 1 { open[column] = -1 }
    for row: 0..topup_qr.size - 1 {
        for column: 0..QR_SIZE_MAX - 1 { next[column] = -1 }
        column: s32 = 0
        while column < topup_qr.size {
            if !QrModule(*topup_qr, column, row) { column += 1; continue }
            start := column
            while column < topup_qr.size && QrModule(*topup_qr, column, row) { column += 1 }
            above := open[start]
            if above >= 0 && topup_qr_rects[above].width == column - start {
                topup_qr_rects[above].height += 1
                next[start] = above
            } else if topup_qr_count < QR_RECTS {
                topup_qr_rects[topup_qr_count] = QrRect.{start, cast(s32)row, column - start, 1}
                next[start] = topup_qr_count
                topup_qr_count += 1
            } else {
                topup_qr_valid = false
                return
            }
        }
        open = next
    }
}

// "0.05 XMR · about $29.53".
XmrAndUsd :: (atomic: s64, usd_cents: s64, output: []u8) -> string {
    xmr: [48]u8
    dollars: [48]u8
    about: [96]u8
    at: s64 = 0
    if !Append(output, *at, XmrText(atomic, xmr[:])) { return "" }
    usd := UsdText(UsdCents(atomic, usd_cents), dollars[:])
    if usd != "" && (!Append(output, *at, " · ") || !Append(output, *at, Fill(topup_copy.about, usd, "", "", about[:]))) { return "" }
    return TextUntilNul(output)
}

// A balance in token units as Monero and dollars.
WorthText :: (units: s64, rate: DewRate, usd_cents: s64, output: []u8) -> string {
    reduced := ReducedRate(rate)
    if reduced.units <= 0 || units < 0 || units > 9223372036854775807 / reduced.atomic { return "" }
    return XmrAndUsd(units * reduced.atomic / reduced.units, usd_cents, output)
}

// "500 Dew = 0.05 XMR · about $29.54".
AmountText :: (dew: s64, atomic: s64, usd_cents: s64, output: []u8) -> string {
    if dew <= 0 { return topup_copy.choose_amount }
    if atomic <= 0 { return topup_copy.loading_rate }
    digits: [24]u8
    worth: [160]u8
    return Fill(topup_copy.amount, FormatInteger(dew, digits[:]), XmrAndUsd(atomic, usd_cents, worth[:]), "", output)
}

// One deposit as "0.05 XMR · 3 of 10 confirmations" or what became of it.
DepositText :: (deposit: DewDeposit, required: s64, output: []u8) -> string {
    xmr: [48]u8
    first: [24]u8
    second: [24]u8
    amount := XmrText(deposit.atomic, xmr[:])
    state := TextUntilNul(deposit.status[:])
    if state == "credited" {
        dew: [48]u8
        unused DewFormat(deposit.units, DewUnits, dew[:])
        return Fill(topup_copy.deposit_credited, amount, TextUntilNul(dew[:]), "", output)
    }
    if state == "confirmed" { return Fill(topup_copy.deposit_confirmed, amount, "", "", output) }
    if state == "below_minimum" { return Fill(topup_copy.deposit_below, amount, "", "", output) }
    if state == "double_spend" { return Fill(topup_copy.deposit_double, amount, "", "", output) }
    seen := ifx deposit.confirmations < required then deposit.confirmations else required
    return Fill(topup_copy.deposit_confirming, amount, FormatInteger(seen, first[:]), FormatInteger(required, second[:]), output)
}
